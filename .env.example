# ============================================================================
# การตั้งค่าระบบรับฝากไฟล์ผ่าน LINE OA (Windows 10 / 11 Configuration)
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงก่อนเปิดใช้งานระบบ
# ห้ามนำไฟล์ .env ที่มีค่า Secret จริงขึ้น Git Repository เด็ดขาด
# ============================================================================

# 1. การตั้งค่า Server
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# URL สาธารณะที่ได้จาก Cloudflare Tunnel (เช่น https://xxxx.trycloudflare.com หรือ https://files.yourdomain.com)
PUBLIC_BASE_URL=http://localhost:3000

# 2. การตั้งค่าพื้นที่จัดเก็บไฟล์และฐานข้อมูล (REQ-01, REQ-10)
# บนเครื่อง Windows แนะนำให้ใช้ D:\LINE_FILE_STORAGE (หรือ C:\LINE_FILE_STORAGE หากไม่มี Drive D:)
# ระบบจะสร้างโฟลเดอร์ย่อย storage/private, storage/public, database, backups, logs, temp ให้อัตโนมัติ
STORAGE_ROOT_PATH=D:\LINE_FILE_STORAGE

# โฟลเดอร์สำหรับเก็บ Backup (REQ-12)
# หากเว้นว่างไว้ ระบบจะใช้ {STORAGE_ROOT_PATH}\backups โดยอัตโนมัติ
# แนะนำให้ชี้ไปยัง Drive อื่นหรือ External Drive หากต้องการป้องกันกรณี Disk หลักเสีย
BACKUP_ROOT_PATH=

# 3. การตั้งค่าบัญชีผู้ดูแลระบบเริ่มต้น (Initial Admin Bootstrap - REQ-05, REQ-06)
# บัญชีนี้จะถูกสร้างอัตโนมัติเมื่อเปิดระบบครั้งแรก และจะถูกบังคับให้เปลี่ยนรหัสผ่านเมื่อ Login ครั้งแรก
INITIAL_ADMIN_USER_ID=admin
INITIAL_ADMIN_NAME=อาจารย์ผู้ดูแลระบบ
INITIAL_ADMIN_PASSWORD=ChangeMe_Initial_Admin_123!

# 4. การตั้งค่าความปลอดภัยและ Session (REQ-06, Section 8)
SESSION_SECRET=replace_with_a_long_random_64_character_hex_string_before_production
SESSION_TTL_HOURS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 5. การตั้งค่า LINE Messaging API (REQ-02, REQ-08, Section 7)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE userId ของอาจารย์ผู้ส่งไฟล์ (33 ตัวอักษร ขึ้นต้นด้วย U เช่น U1234567890abcdef1234567890abcdef)
# หากระบุค่านี้ ระบบจะรับไฟล์เฉพาะจากอาจารย์คนนี้เท่านั้นตาม REQ-02
# หากเว้นว่างไว้ในครั้งแรกที่ติดตั้ง สามารถดู LINE userId ของอาจารย์ได้จากหน้า Admin -> Webhook Logs เมื่ออาจารย์ทักแชท
ALLOWED_SENDER_LINE_USER_ID=

# 6. ข้อจำกัดขนาดไฟล์และพื้นที่ว่างบน Disk (REQ-09)
# ขนาดไฟล์สูงสุดที่อนุญาตตามขีดจำกัดของ LINE Content API (ค่าเริ่มต้น 300 MB = 314572800 bytes)
MAX_FILE_SIZE_BYTES=314572800
# พื้นที่ว่างขั้นต่ำบน Disk ที่ต้องเหลืออยู่ก่อนอนุญาตให้รับไฟล์ใหม่ (ค่าเริ่มต้น 1 GB = 1073741824 bytes)
MIN_FREE_DISK_BYTES=1073741824

# 7. การตั้งค่าการรวมกลุ่ม Notification (REQ-18)
# หน้าต่างเวลา (วินาที) สำหรับรวมไฟล์ที่อาจารย์ส่งต่อเนื่องกันให้อยู่ในกลุ่ม Notification เดียวกัน
NOTIFICATION_GROUP_WINDOW_SECONDS=120

# 8. การตั้งค่าระบบ Backup อัตโนมัติทุก 6 ชั่วโมง (REQ-12)
BACKUP_CRON_SCHEDULE=0 */6 * * *
# หมายเหตุ: ตาม REQ-12 ระบบจะไม่ลบ Backup เก่าอัตโนมัติ (0 = เก็บทุกชุดจนกว่าผู้ใช้จะอนุมัตินโยบาย Retention)
BACKUP_RETENTION_DAYS=0

